+- (nullable UIScrollView *)contentScrollViewForEdge:(NSDirectionalRectEdge)edge
+{
+  UIScrollView *configuredScrollView = [super contentScrollViewForEdge:edge];
+  if (edge != NSDirectionalRectEdgeBottom) {
+    return configuredScrollView;
+  }
+
+  if (configuredScrollView != nil &&
+      (configuredScrollView.alwaysBounceVertical ||
+       configuredScrollView.contentSize.height > configuredScrollView.bounds.size.height + 1.0)) {
+    return configuredScrollView;
+  }
+
+  return [RNSScrollViewFinder findScrollViewBreadthFirstFrom:self.view];
 }
 
